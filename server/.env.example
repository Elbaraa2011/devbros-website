# Example environment file. Copy to .env and fill in real values.

# Port the server listens on
PORT=3000

# Public base URL of the site (used for CORS and links in emails)
SITE_URL=http://localhost:3000

# SMTP settings. For Gmail, create an App Password at
# https://myaccount.google.com/apppasswords and put it in SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Email routing
NOTIFICATION_EMAIL=devbros40@gmail.com

# When true, emails are skipped and logged to the console (local dev)
SKIP_EMAIL=false
